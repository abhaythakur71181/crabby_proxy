# Copy to .env (gitignored) and fill in before `docker compose up`.
# compose.yaml refuses to start without the three secrets below.

# --- Required secrets ---------------------------------------------------------
# >= 32 random bytes, e.g. `openssl rand -base64 48`
CRABBY_JWT_SECRET=
CRABBY_ADMIN_PASSWORD=
CRABBY_BASIC_AUTH_PASSWORD=

# --- Image tag ----------------------------------------------------------------
# Tag builds with a version or git SHA so a previous tag can be rolled back to.
# Unset falls back to :latest.
# CRABBY_IMAGE_TAG=

# --- Ports / exposure ---------------------------------------------------------
# PROXY_PORT=8080
# ADMIN_PORT=8081
# Keep the admin API on localhost unless it is behind a firewall / private net.
# ADMIN_BIND_HOST=127.0.0.1
# WEBV2_PORT=3001
# RUST_LOG=info

# --- Resource limits ----------------------------------------------------------
# PROXY_MEM_LIMIT=1g
# PROXY_CPUS=2.0
# PROXY_PIDS_LIMIT=4096
# WEBV2_MEM_LIMIT=128m
# WEBV2_CPUS=0.5
# WEBV2_PIDS_LIMIT=512

# --- SQLite backup sidecar (`docker compose --profile backup up -d`) ----------
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_SECONDS=21600
# BACKUP_RETENTION_DAYS=14
